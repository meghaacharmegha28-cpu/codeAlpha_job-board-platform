PORT=3000
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1d
DATABASE_PATH=./data/job-board.sqlite
UPLOAD_DIR=./uploads/resumes
MAX_UPLOAD_MB=5
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:3000

# Gmail: use a Google App Password (not your regular Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
MAIL_FROM=Job Board Platform <your-email@gmail.com>

# Used only by `npm run seed:admin`; never enabled through public registration.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
